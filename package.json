{
  "name": "mx-astro-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare.mjs && vite --host 0.0.0.0",
    "build": "pnpm test && node scripts/prepare.mjs && tsc --noEmit && vite build && node scripts/finalize.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "swisseph-wasm": "0.1.0",
    "@js-temporal/polyfill": "0.5.1"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "6.4.1",
    "@types/node": "22.19.0"
  },
  "packageManager": "pnpm@11.25.0"
}
